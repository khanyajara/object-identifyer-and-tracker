PERFORMANCE_MODE=balanced
# auto uses browser streaming on Linux servers without /dev/video devices.
CAMERA_INPUT_MODE=auto
# JSON list of STUN/TURN servers. Configure TURN for restricted hosting networks.
ROADWATCH_WEBRTC_ICE_SERVERS=
ROADWATCH_DEVICE_ID=roadwatch_local_01
# Generate a bcrypt hash locally with:
# python -m services.auth_service --hash-password
# Then set a strong 32+ character JWT secret and one or more admin accounts.
# Do not put plaintext passwords in this file or commit a populated .env file.
ROADWATCH_JWT_SECRET=
ROADWATCH_JWT_EXPIRES_MINUTES=60
# Example format (replace the placeholder hash):
# ROADWATCH_ADMIN_ACCOUNTS=[{"username":"admin","password_hash":"$2b$12$replace_with_generated_hash","role":"super_admin"}]
ROADWATCH_ADMIN_ACCOUNTS=[]
PREVIEW_MODE=opencv-streamlit
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
TARGET_CAMERA_FPS=30
CAMERA_BUFFER_SIZE=1
AI_QUEUE_MAXSIZE=1
AI_FRAME_WIDTH=640
AI_FRAME_HEIGHT=360
AI_PROCESS_INTERVAL_SECONDS=0.5
YOLO_IMAGE_SIZE=416
ENABLE_TRACKING=true
ENABLE_OCR=true
ENABLE_MOVEMENT=true
SAVE_SNAPSHOTS=false
SAVE_ANNOTATED_VIDEO=true
KEEP_FALLBACK_VIDEO=false
LOG_FLUSH_INTERVAL_SECONDS=5
STREAMLIT_PREVIEW_FPS=5
ROADWATCH_LOCATION_TRACKING=true
ROADWATCH_REVERSE_GEOCODING=false
ROADWATCH_SAVE_GPS_HISTORY=true
ROADWATCH_HIGH_ACCURACY_LOCATION=false
ROADWATCH_SHOW_CURRENT_ADDRESS=true
VISION_SYNC_URL=
VISION_SYNC_API_KEY=
AI_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=Dash-cam
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=Dash-cam
FIREBASE_PUSH_URL=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_VIDEO_COLLECTION=videos
ROADWATCH_NOTIFICATION_WEBHOOK_URL=
ROADWATCH_SMTP_HOST=
ROADWATCH_SMTP_USERNAME=
ROADWATCH_SMTP_PASSWORD=
ROADWATCH_EMAIL_FROM=
ROADWATCH_EMAIL_TO=
DUAL_CAMERA_ENABLED=true
FRONT_CAMERA_INDEX=0
REAR_CAMERA_INDEX=1
# Automatic background service; cabin source is provisioned by the administrator.
DRIVER_MONITORING_ENABLED=true
DRIVER_MONITORING_BACKGROUND=true
DRIVER_FACE_RECOGNITION_ENABLED=true
DRIVER_CAMERA_SOURCE=dedicated
# Dedicated camera must not share the front/road or enabled rear camera index.
DRIVER_CAMERA_INDEX=
DRIVER_FRAME_WIDTH=640
DRIVER_FRAME_HEIGHT=480
DRIVER_FACE_DETECTION_FPS=5
DRIVER_NO_FACE_FPS=4
DRIVER_IDLE_DETECTION_FPS=1
DRIVER_IDLE_AFTER_SECONDS=30
DRIVER_LANDMARK_FPS=10
DRIVER_LANDMARKS_ENABLED=true
DRIVER_LANDMARKS_WHEN_IDLE=false
FACE_RECOGNITION_UNVERIFIED_INTERVAL_SECONDS=2
FACE_RECOGNITION_CANDIDATE_INTERVAL_SECONDS=1
FACE_RECOGNITION_VERIFIED_INTERVAL_SECONDS=7
DRIVER_EMBEDDING_INDEX_TTL_SECONDS=300
DRIVER_DATABASE_RETRY_SECONDS=30
DRIVER_RECOVERY_SECONDS=5
DRIVER_FACE_LOST_TIMEOUT_SECONDS=5
FACE_RECOGNITION_REQUIRED_MATCHES=3
# REQUIRED: calibrate against enrolled and non-enrolled validation samples.
# Blank disables recognition and enrollment; there is no production default.
FACE_RECOGNITION_THRESHOLD=
DRIVER_SEAT_X=0.5
DRIVER_SEAT_Y=0.5
DRIVER_SEAT_RADIUS=0.35
DRIVER_YUNET_MODEL=models/face_detection_yunet.onnx
DRIVER_SFACE_MODEL=models/face_recognition_sface.onnx
DRIVER_LANDMARK_MODEL=models/face_landmarker.task
# Set true only after deploying rules denying all client access to biometrics.
DRIVER_BIOMETRICS_RULES_CONFIGURED=false

# Temporal fatigue (administrator calibration; blank values never trigger alerts).
DRIVER_FATIGUE_ENABLED=true
DRIVER_FATIGUE_EYE_CLOSED_RATIO=
DRIVER_FATIGUE_MOUTH_OPEN_RATIO=
DRIVER_FATIGUE_NEUTRAL_PITCH=
DRIVER_FATIGUE_CLOSED_SECONDS=1.5
DRIVER_FATIGUE_CRITICAL_SECONDS=3
DRIVER_FATIGUE_YAWN_SECONDS=2
DRIVER_FATIGUE_NOD_SECONDS=0.5
DRIVER_FATIGUE_NOD_DELTA=15
DRIVER_FATIGUE_WINDOW_SECONDS=60
DRIVER_FATIGUE_MINIMUM_OBSERVATION=20
DRIVER_FATIGUE_PERCLOS_WARNING=0.3
DRIVER_FATIGUE_MAX_GAP=0.5
DRIVER_FATIGUE_COOLDOWN_SECONDS=30
